{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd ../.. && npm ci --ignore-scripts --no-audit --no-fund -w packages/admin-dashboard -w packages/shared",
  "buildCommand": "cd ../.. && npm run build -w packages/shared && npm run build -w packages/admin-dashboard",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
