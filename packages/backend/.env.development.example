# Minimal local-development .env for the backend. See docs/local-dev.md.
# Create packages/backend/.env from it with: ./scripts/init-env.sh  (fills the secrets below)
# The full list of settings, including production ones, is in /.env.example.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Postgres 16 and Redis on this machine (Homebrew or Docker; see docs/local-dev.md)
DATABASE_URL=postgresql://user:password@localhost:5432/lotto_maker
REDIS_URL=redis://localhost:6379

# Filled by init-env.sh (openssl rand). Two different values, 32+ characters each.
JWT_SECRET=__GENERATE__
JWT_REFRESH_SECRET=__GENERATE__
# 32-byte keys, base64. Filled by init-env.sh.
ID_ENCRYPTION_KEY=__GENERATE__
ID_HASH_KEY=__GENERATE__

# Payments: only the mock provider exists
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=__GENERATE__
PUBLIC_API_URL=http://localhost:3000
CHECKOUT_RETURN_ORIGINS=http://localhost:3002,http://localhost:5173,http://localhost:5174

# Browsers allowed to call the API: web (3002), operator dashboard (5173), admin dashboard (5174),
# Expo web (8081, 19006)
ALLOWED_ORIGINS=http://localhost:3002,http://localhost:5173,http://localhost:5174,http://localhost:8081,http://localhost:19006

# SMS: leave empty. Without Twilio the OTP code is printed in this backend's console:
#   [OTP_DEV] +9725XXXXXXXX → 123456
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Dev seed (npm run db:seed): your own phones, E.164 (+9725XXXXXXXX). Logging in with
# SEED_ADMIN_PHONE gives the admin role, SEED_OPERATOR_PHONE the operator role.
SEED_ADMIN_PHONE=
SEED_OPERATOR_PHONE=

# One process runs both the API and the scheduled jobs locally
RUN_API=true
RUN_JOBS=true
