generator client {
  provider      = "prisma-client-js"
  output        = "../../../node_modules/.prisma/client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserStatus {
  active
  suspended
}

enum GameType {
  lotto
  chance
  seven77
  one23
}

enum DrawDay {
  tue
  thu
  sat
}

enum OrderType {
  one_time
  subscription
}

enum OrderStatus {
  pending
  in_queue
  keyed
  scanned
  won
  lost
  refunded
  results_delayed
  cancelled
}

enum QueueSlotStatus {
  waiting
  in_progress
  done
  failed
}

enum WalletTransactionType {
  deposit
  charge
  refund
  winning
  refund_reversal
}

enum PaymentStatus {
  pending
  approved
  failed
  refunded
}

enum SubscriptionEventStatus {
  success
  skipped
}

enum TicketType {
  regular
  double
}

enum DrawStatus {
  scheduled
  results_suggested
  results_confirmed
  settled
}

enum PrizeGame {
  lotto
  double
  extra
}

enum PrizeClaimStatus {
  awaiting_pickup
  collected
}

enum PendingCardCreditStatus {
  pending
  paid
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id            String     @id @default(cuid())
  phone         String     @unique
  fullName      String?
  // National ID: AES-256-GCM ciphertext, keyed HMAC for the duplicate check,
  // and the last 4 digits (shown to operators for the prize form).
  idNumberEnc   String?
  idNumberHash  String?    @unique
  idLast4       String?
  // Plaintext ID from before encryption. Emptied by the startup backfill
  // (lib/backfill-id-encryption.ts); TODO: drop the column once that has run in production.
  idNumberLegacy String?
  // Only the birth year is kept; the full date of birth is used once, for the age check.
  birthYear     Int?
  verifiedAdult Boolean    @default(false)
  walletBalance Decimal    @default(0) @db.Decimal(12, 2)
  status        UserStatus @default(active)
  fcmToken      String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  orders        Order[]
  subscriptions Subscription[]
  walletTxs     WalletTransaction[]
  deviceTokens  DeviceToken[]
  payments      Payment[]
  tickets       Ticket[]
  prizeClaims   PrizeClaim[]
  pendingCardCredits PendingCardCredit[]
  savedCards    SavedCard[]

  @@index([phone])
}

model Subscription {
  id           String    @id @default(cuid())
  userId       String
  gameType     GameType
  numbers      Json
  strongNumber Int?
  drawDays     DrawDay[]
  active       Boolean   @default(true)
  nextDrawDate DateTime?
  pricePerDraw Decimal   @db.Decimal(8, 2)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User               @relation(fields: [userId], references: [id])
  orders       Order[]
  events       SubscriptionEvent[]

  @@index([userId, active])
}

model Order {
  id             String      @id @default(cuid())
  userId         String
  subscriptionId String?
  gameType       GameType
  // Legacy flat numbers from before Phase 2. New orders use ticketId. TODO: drop with the other legacy games.
  numbers        Json?
  strongNumber   Int?
  drawDate       DateTime
  drawTime       DateTime
  type           OrderType
  status         OrderStatus @default(pending)
  // Object key in the private scan bucket. Never a URL; read via a signed URL.
  ticketScanKey  String?
  // Lotto: the ticket and the draw this order plays. Null only on pre-Phase-2 rows.
  ticketId       String?
  drawId         String?
  // Extra digits the terminal printed for this form (6 digits, 1-7); empty if no Extra.
  extraDigits    Int[]
  price         Decimal     @db.Decimal(8, 2)
  fee            Decimal     @db.Decimal(8, 2)
  totalCharged   Decimal     @db.Decimal(8, 2)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  keyedAt        DateTime?
  scannedAt      DateTime?

  user           User          @relation(fields: [userId], references: [id])
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  ticket         Ticket?       @relation(fields: [ticketId], references: [id])
  draw           Draw?         @relation(fields: [drawId], references: [id])
  queueSlot      QueueSlot?
  walletTxs      WalletTransaction[]
  auditLogs      AuditLog[]
  wins           OrderWin[]
  prizeClaim     PrizeClaim?
  pendingCardCredits PendingCardCredit[]

  @@index([drawId, status])
  @@index([ticketId])
  @@index([userId, status])
  @@index([drawDate, status])
}

model Location {
  id                     String     @id @default(cuid())
  name                   String
  address                String
  maxConcurrentOperators Int        @default(1)
  activeHours            Json
  active                 Boolean    @default(true)
  createdAt              DateTime   @default(now())

  operators              Operator[]
  queueSlots             QueueSlot[]
}

model Operator {
  id                String     @id @default(cuid())
  name              String
  phone             String?    @unique
  locationId        String
  active            Boolean    @default(true)
  throughputPerHour Int        @default(50)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  location          Location   @relation(fields: [locationId], references: [id])
  queueSlots        QueueSlot[]

  @@index([locationId, active])
}

model QueueSlot {
  id          String          @id @default(cuid())
  orderId     String          @unique
  operatorId  String?
  locationId  String
  priority    Int             @default(100)
  deadline    DateTime
  status      QueueSlotStatus @default(waiting)
  retryCount  Int             @default(0)
  assignedAt  DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())

  order       Order           @relation(fields: [orderId], references: [id])
  operator    Operator?       @relation(fields: [operatorId], references: [id])
  location    Location        @relation(fields: [locationId], references: [id])

  @@index([status, priority, deadline])
  @@index([locationId, status])
}

model WalletTransaction {
  id          String                @id @default(cuid())
  userId      String
  type        WalletTransactionType
  amount      Decimal               @db.Decimal(12, 2)
  orderId     String?
  // Set on deposits and on their refund_reversal. Unique together with the type:
  // a payment credits the wallet at most once and is reversed at most once.
  paymentId   String?
  description String
  createdAt   DateTime              @default(now())

  user        User                  @relation(fields: [userId], references: [id])
  order       Order?                @relation(fields: [orderId], references: [id])
  payment     Payment?              @relation(fields: [paymentId], references: [id])

  @@unique([paymentId, type])
  @@index([userId, createdAt])
}

// A card payment at an external provider. The wallet is credited only when the
// provider's signed webhook reports the payment as approved.
model Payment {
  id             String        @id @default(cuid())
  provider       String
  providerTxId   String        @unique
  userId         String
  amount         Decimal       @db.Decimal(12, 2)
  status         PaymentStatus @default(pending)
  idempotencyKey String        @unique
  checkoutUrl    String?
  cardLast4      String?
  cardToken      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user           User          @relation(fields: [userId], references: [id])
  walletTxs      WalletTransaction[]

  @@index([userId, createdAt])
}

model SubscriptionEvent {
  id             String                  @id @default(cuid())
  subscriptionId String
  orderId        String?
  drawDate       DateTime
  status         SubscriptionEventStatus
  skipReason     String?
  createdAt      DateTime                @default(now())

  subscription   Subscription            @relation(fields: [subscriptionId], references: [id])

  // Prevents duplicate processing if the cron fires more than once per draw
  @@unique([subscriptionId, drawDate])
  @@index([subscriptionId])
  @@index([drawDate])
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String
  platform  String   @default("android")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])

  @@unique([token])
  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  orderId    String?
  action     String
  actorId    String?
  actorType  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  order      Order?   @relation(fields: [orderId], references: [id])

  @@index([entityType, entityId])
  @@index([orderId])
  @@index([createdAt])
}

// ─── Lotto tickets, draws and prizes ─────────────────────────────────────────

model Ticket {
  id             String     @id @default(cuid())
  userId         String
  type           TicketType
  // Key into SYSTEMATIC_RULES (packages/shared); null for plain tables.
  systematicType String?
  extra          Boolean    @default(false)
  drawCount      Int        @default(1)
  createdAt      DateTime   @default(now())

  user           User          @relation(fields: [userId], references: [id])
  tables         TicketTable[]
  orders         Order[]

  @@index([userId, createdAt])
}

model TicketTable {
  id            String @id @default(cuid())
  ticketId      String
  position      Int
  // 6 numbers (6-12 for a systematic table), 1-37.
  numbers       Int[]
  // 1 strong number (up to 7 for a strong-systematic table), 1-7.
  strongNumbers Int[]

  ticket        Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([ticketId, position])
}

// Prices live here, never in code. The row with the latest effectiveFrom <= now applies.
model PriceList {
  id                 String     @id @default(cuid())
  ticketType         TicketType
  effectiveFrom      DateTime
  // Pais price of one table, not including Extra.
  pricePerTable      Decimal    @db.Decimal(8, 2)
  // Pais price of Extra per form (once per order, not per table). Null = Extra is refused.
  extraPricePerForm  Decimal?   @db.Decimal(8, 2)
  // Our fee per order (one ticket for one draw).
  feePerOrder        Decimal    @db.Decimal(8, 2)
  createdAt          DateTime   @default(now())

  @@unique([ticketType, effectiveFrom])
}

model Draw {
  id            String     @id @default(cuid())
  drawNumber    Int        @unique
  drawAt        DateTime
  salesCloseAt  DateTime
  numbers       Int[]
  strong        Int?
  extraDigits   Int[]
  status        DrawStatus @default(scheduled)
  suggestedAt   DateTime?
  confirmedAt   DateTime?
  confirmedById String?
  settledAt     DateTime?
  // Set when a ticket hit a tier with no prize amount (e.g. an unwon jackpot showing 0 ₪)
  needsAttention  Boolean  @default(false)
  attentionReason String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  confirmedBy  Admin?     @relation(fields: [confirmedById], references: [id])
  prizeTiers    PrizeTier[]
  orders        Order[]

  @@index([status, drawAt])
}

model PrizeTier {
  id           String    @id @default(cuid())
  drawId       String
  game         PrizeGame
  // lotto/double: 6+s, 6, 5+s, 5, 4+s, 4, 3+s, 3. extra: 6, 5, 4, 3, 2 (matching digits).
  tier         String
  winnersCount Int       @default(0)
  prizeAmount  Decimal   @db.Decimal(12, 2)

  draw         Draw      @relation(fields: [drawId], references: [id], onDelete: Cascade)

  @@unique([drawId, game, tier])
}

model OrderWin {
  id      String    @id @default(cuid())
  orderId String
  game    PrizeGame
  tier    String
  // Number of winning combinations in this tier.
  count   Int
  // Total prize for those combinations.
  amount  Decimal   @db.Decimal(12, 2)

  order   Order     @relation(fields: [orderId], references: [id])

  @@unique([orderId, game, tier])
}

// A prize above SMALL_PRIZE_LIMIT: the user collects it with the original ticket and ID.
model PrizeClaim {
  id        String           @id @default(cuid())
  orderId   String           @unique
  userId    String
  amount    Decimal          @db.Decimal(12, 2)
  status    PrizeClaimStatus @default(awaiting_pickup)
  createdAt DateTime         @default(now())

  order     Order            @relation(fields: [orderId], references: [id])
  user      User             @relation(fields: [userId], references: [id])

  @@index([userId])
}

// Part of a small prize that did not fit under the wallet cap.
// TODO: pay out to the user's card.
model PendingCardCredit {
  id        String                  @id @default(cuid())
  orderId   String                  @unique
  userId    String
  amount    Decimal                 @db.Decimal(12, 2)
  status    PendingCardCreditStatus @default(pending)
  createdAt DateTime                @default(now())

  order     Order                   @relation(fields: [orderId], references: [id])
  user      User                    @relation(fields: [userId], references: [id])

  @@index([userId, status])
}

// A card the user paid with, tokenised by the payment provider. The newest active card is the
// default one for payouts. Only last4 and brand are ever shown to the client.
model SavedCard {
  id        String   @id @default(cuid())
  userId    String
  token     String
  last4     String
  brand     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, token])
  @@index([userId, active, createdAt])
}

// Back-office admin: confirms draw results. Separate from Operator.
model Admin {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  confirmedDraws Draw[]
}
