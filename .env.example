# Copy to .env and fill in values

# Backend
DATABASE_URL=postgresql://user:password@localhost:5432/lotto_maker
REDIS_URL=redis://localhost:6379
JWT_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_another_long_random_string
PORT=3000

# Twilio (SMS OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1234567890

# Firebase (push notifications)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cloudflare R2 (ticket scan storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=lotto-maker-scans

# Payments / wallet
# Only the "mock" provider exists so far. It is refused when NODE_ENV=production,
# so deposits stay closed in production until a real provider is added.
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=change_me_to_a_long_random_string
# Public base URL of the API (used to build checkout links)
PUBLIC_API_URL=http://localhost:3000
# Origins the checkout may return to (POST /payments/checkout successUrl / cancelUrl), comma-separated.
# Empty: return URLs are refused with 422.
CHECKOUT_RETURN_ORIGINS=http://localhost:5173
# Maximum wallet balance in ILS; a deposit that would exceed it is rejected
WALLET_BALANCE_CAP=2600
# Withdrawals (ILS): minimum amount, fee of a bank transfer (card is free), and the card-withdrawal
# size up to which no admin approval is needed
MIN_WITHDRAWAL_AMOUNT=10
BANK_WITHDRAWAL_FEE=25
AUTO_APPROVE_WITHDRAWAL_LIMIT=500
# How long a big prize can be collected after the draw
PRIZE_CLAIM_RETENTION_DAYS=182

# ID-number protection (required in production). Generate each with: openssl rand -base64 32
# ID_ENCRYPTION_KEY: AES-256-GCM key for ID numbers. Back it up: without it stored IDs are unreadable.
# ID_HASH_KEY: HMAC key for the duplicate-ID check. Must not change once users exist.
ID_ENCRYPTION_KEY=
ID_HASH_KEY=

# Environment
NODE_ENV=development

# ─── Phase 7: production settings ────────────────────────────────────────────
# NODE_ENV=production refuses to start unless all of these are set (it prints the full list):
# JWT_SECRET / JWT_REFRESH_SECRET (32+ chars, different), ID_ENCRYPTION_KEY, ID_HASH_KEY, REDIS_URL,
# PAYMENT_WEBHOOK_SECRET, BUSINESS_NAME / BUSINESS_ID / BUSINESS_ADDRESS, and on the API service also
# ALLOWED_ORIGINS, CHECKOUT_RETURN_ORIGINS and PUBLIC_API_URL (https origins only).

# Fee receipts: the issuer printed on every receipt (required in production)
BUSINESS_NAME=
BUSINESS_ID=
BUSINESS_ADDRESS=
VAT_RATE=0.18

# Browser origins allowed to call the API (web app, admin and operator dashboards), comma-separated.
# Unset outside production: the usual localhost ports. (CORS_ORIGINS is the old name, still read.)
ALLOWED_ORIGINS=http://localhost:3002,http://localhost:5173

# Process split: the same image runs as the API (RUN_JOBS=false) and as the worker (RUN_API=false).
# Both true (default) runs everything in one process, which is what local development uses.
RUN_API=true
RUN_JOBS=true
# Docker entrypoint only: run `prisma migrate deploy` before start. Set false on the worker.
RUN_MIGRATIONS=true

# Logging and HTTP
LOG_LEVEL=info
# Reverse-proxy hops whose X-Forwarded-For is trusted for the client IP. Unset: 1 in production, else 0.
# TRUST_PROXY_HOPS=1
BODY_LIMIT_BYTES=262144
RATE_LIMIT_GLOBAL_PER_MINUTE=120
# Swagger UI at /docs. Unset: on outside production, off in production.
# ENABLE_API_DOCS=false
READY_CHECK_TIMEOUT_MS=2000
SHUTDOWN_TIMEOUT_MS=25000

# Error monitoring (optional, off by default). Needs `npm i @sentry/node -w packages/backend`.
SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
