{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "fra1"
  ],
  "services": {
    "web": {
      "root": "packages/web",
      "framework": "nextjs",
      "installCommand": "sh ../../scripts/vercel-install.sh",
      "buildCommand": "cd ../.. && npm run build -w packages/web",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "API_URL"
        }
      ]
    },
    "backend": {
      "root": "packages/backend",
      "entrypoint": "vercel-entry.js",
      "installCommand": "sh ../../scripts/vercel-install.sh",
      "buildCommand": "sh scripts/vercel-build.sh",
      "outputDirectory": "public",
      "functions": {
        "vercel-entry.js": {
          "maxDuration": 300
        }
      }
    },
    "admin": {
      "root": "packages/admin-dashboard",
      "framework": "vite",
      "installCommand": "sh ../../scripts/vercel-install.sh",
      "buildCommand": "sh ../../scripts/vercel-build-spa.sh admin-dashboard /admin/",
      "outputDirectory": "vercel-out",
      "rewrites": [
        {
          "source": "/admin/(.*)",
          "destination": "/admin/index.html"
        },
        {
          "source": "/admin",
          "destination": "/admin/index.html"
        }
      ]
    },
    "operator": {
      "root": "packages/operator-dashboard",
      "framework": "vite",
      "installCommand": "sh ../../scripts/vercel-install.sh",
      "buildCommand": "sh ../../scripts/vercel-build-spa.sh operator-dashboard /ops/",
      "outputDirectory": "vercel-out",
      "rewrites": [
        {
          "source": "/ops/(.*)",
          "destination": "/ops/index.html"
        },
        {
          "source": "/ops",
          "destination": "/ops/index.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/backend/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/admin",
      "destination": {
        "service": "admin"
      }
    },
    {
      "source": "/admin/(.*)",
      "destination": {
        "service": "admin"
      }
    },
    {
      "source": "/ops",
      "destination": {
        "service": "operator"
      }
    },
    {
      "source": "/ops/(.*)",
      "destination": {
        "service": "operator"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
