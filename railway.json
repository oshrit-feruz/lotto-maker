{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "packages/backend/**",
      "packages/shared/**",
      "Dockerfile",
      "docker-entrypoint.sh",
      "package.json",
      "package-lock.json"
    ]
  },
  "deploy": {
    "healthcheckPath": "/ready",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
